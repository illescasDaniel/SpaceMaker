{
	"platforms": {
		"linux-x86_64": {
			"adb": {
				"strategy": "zip",
				"url": "https://dl.google.com/android/repository/platform-tools_r35.0.2-linux.zip",
				"files": { "adb": "platform-tools/adb" }
			},
			"ffmpeg": {
				"strategy": "archive",
				"url": "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz",
				"files": { "ffmpeg": "ffmpeg", "ffprobe": "ffprobe" }
			},
			"ffprobe": { "companion_of": "ffmpeg" },
			"magick": {
				"strategy": "file",
				"url": "https://github.com/ImageMagick/ImageMagick/releases/download/7.1.2-31/ImageMagick-7.1.2-31-gcc-x86_64.AppImage"
			},
			"exiftool": {
				"strategy": "archive",
				"url": "https://sourceforge.net/projects/exiftool/files/Image-ExifTool-13.59.tar.gz/download",
				"files": { "exiftool": "exiftool" }
			}
		},
		"linux-aarch64": {
			"adb": {
				"strategy": "zip",
				"url": "https://dl.google.com/android/repository/platform-tools_r35.0.2-linux.zip",
				"files": { "adb": "platform-tools/adb" }
			},
			"ffmpeg": {
				"strategy": "archive",
				"url": "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-arm64-static.tar.xz",
