{
	"mcpServers": {
		"codenav": {
			"command": "uvx",
			"args": [
				"--from",
				"codenav-mcp>=0.2.0,<0.3",
				"codenav-mcp"
			],
			"env": {
				"CODENAV_MCP_WORKSPACE": "${workspaceFolder}",
				"CODENAV_MCP_SOURCE_ROOT": "src",
				"CODENAV_MCP_EXTRA_SOURCE_ROOTS": "tests"
			}
		},
		"webnav": {
			"command": "npx",
			"args": [
				"--yes",
				"webnav-ts-mcp@^0.1.1"
			],
			"env": {
				"WEBNAV_MCP_WORKSPACE": "${workspaceFolder}",
				"WEBNAV_MCP_ROOTS": "web=web/src,static=src/spacemaker/adapters/inbound/web/static,wireframes=wireframes",
				"WEBNAV_MCP_EXCLUDE": "src/spacemaker/adapters/inbound/web/static/js"
			}
		},
		"jevmem": {
			"command": "uvx",
			"args": [
				"--from",
				"jevmem",
				"jevmem-mcp"
			],
			"env": {
				"JEVMEM_SCOPE": "project:spacemaker",
				"JEVMEM_DB": "${HOME}/.jevmem/spacemaker.db"
			}
		}
	}
}
