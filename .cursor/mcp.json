{
	"mcpServers": {
		"codenav": {
			"command": "uv",
			"args": [
				"run",
				"--directory",
				"${workspaceFolder}",
				"python",
				"${workspaceFolder}/mcp-servers/codenav_mcp/server.py"
			],
			"env": {
				"CODENAV_MCP_WORKSPACE": "${workspaceFolder}",
				"CODENAV_MCP_SOURCE_ROOT": "src"
			}
		},
		"webnav": {
			"command": "uv",
			"args": [
				"run",
				"--directory",
				"${workspaceFolder}",
				"python",
				"${workspaceFolder}/mcp-servers/webnav_mcp/server.py"
			],
			"env": {
				"WEBNAV_MCP_WORKSPACE": "${workspaceFolder}",
				"WEBNAV_MCP_ROOTS": "static=src/spacemaker/adapters/inbound/web/static,wireframes=wireframes"
			}
		}
	}
}
