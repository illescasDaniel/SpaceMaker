#!/bin/sh
# Regenerate the Graphify knowledge graph artifacts and stage them if changed.
# Installed via: git config core.hooksPath .githooks
#
# --code-only / --no-label / --no-viz: keep this fully offline and API-key-free
# (no LLM backend required) and avoid a native graph.html rendering crash seen
# on some platforms. See docs/ARCHITECTURE.md "Developer setup".
#
# graph.json / GRAPH_REPORT.md embed the commit that produced them, which can
# only ever be the PARENT commit (a file can't contain the hash of the commit
# that contains it — see memory/decisions.md). Left unchecked, that means
# every commit stages a graph diff even when nothing but that stamp changed.
# To avoid that noise, strip the stamp before deciding whether there's a real
# change to stage; if not, restore the committed version instead of staging
# a no-op.

set -e

uv run graphify extract . --code-only
uv run graphify cluster-only . --no-label --no-viz

uv run python - <<'PY'
import json
import pathlib
import subprocess
import time

GRAPH = pathlib.Path("graphify-out/graph.json")
REPORT = pathlib.Path("graphify-out/GRAPH_REPORT.md")


def wait_until_settled(path: pathlib.Path, *, quiet_for: float = 1.0, timeout: float = 15.0) -> None:
	"""cluster-only's process can exit before its own label-backfill write has
	fully landed on disk (observed on Windows: graphify's own hook comments
	note AV-scanned filesystem I/O routinely lags 1s+ behind process exit).
	Poll size+mtime until they stop changing instead of guessing a fixed delay.
	"""
	deadline = time.monotonic() + timeout
	last = None
	stable_since = None
	while time.monotonic() < deadline:
		stat = path.stat()
		current = (stat.st_size, stat.st_mtime_ns)
		if current == last:
			if stable_since is None:
				stable_since = time.monotonic()
			elif time.monotonic() - stable_since >= quiet_for:
				return
		else:
			stable_since = None
		last = current
		time.sleep(0.25)


wait_until_settled(GRAPH)
wait_until_settled(REPORT)


def committed(path: pathlib.Path) -> bytes | None:
	result = subprocess.run(["git", "show", f"HEAD:{path.as_posix()}"], capture_output=True)
	return result.stdout if result.returncode == 0 else None


def normalized_graph(data: bytes) -> dict:
	graph = json.loads(data)
	graph.pop("built_at_commit", None)
	return graph


def normalized_report(data: bytes) -> list[str]:
	return [line for line in data.decode("utf-8").splitlines() if not line.startswith("- Built from commit:")]


old_graph = committed(GRAPH)
old_report = committed(REPORT)

changed = old_graph is None or old_report is None
if not changed:
	changed = normalized_graph(GRAPH.read_bytes()) != normalized_graph(old_graph)
if not changed:
	changed = normalized_report(REPORT.read_bytes()) != normalized_report(old_report)

if changed:
	subprocess.run(["git", "add", str(GRAPH), str(REPORT)], check=True)
	print("[graphify hook] graph changed beyond the commit stamp — staged")
else:
	GRAPH.write_bytes(old_graph)
	REPORT.write_bytes(old_report)
	print("[graphify hook] no real graph change beyond the commit stamp — nothing staged")
PY
