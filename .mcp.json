{
	"mcpServers": {
		"codenav": {
			"command": "uv",
			"args": [
				"run",
				"--no-project",
				"--with-editable",
				"/home/daniel/Projects/Code/MCPs/codenav-mcp",
				"--with-editable",
				"/home/daniel/Projects/Code/MCPs/mcp-nav-shared",
				"python",
				"-m",
				"codenav_mcp.server"
			],
			"env": {
				"CODENAV_MCP_SOURCE_ROOT": "src",
				"CODENAV_MCP_EXTRA_SOURCE_ROOTS": "tests"
			}
		},
		"webnav": {
			"command": "npx",
			"args": [
				"--yes",
				"webnav-ts-mcp@^0.1.1"
			],
			"env": {
				"WEBNAV_MCP_ROOTS": "web=web/src,static=src/spacemaker/adapters/inbound/web/static,wireframes=wireframes",
				"WEBNAV_MCP_EXCLUDE": "src/spacemaker/adapters/inbound/web/static/js"
			}
		},
		"jevmem": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"run",
				"--project",
				"/home/daniel/Projects/Code/Python/Jev-things",
				"jevmem-mcp"
			],
			"env": {
				"JEVMEM_ENV_FILE": "/home/daniel/Projects/Code/Python/Jev-things/.env",
				"JEVMEM_SCOPE": "project:spacemaker",
				"JEVMEM_DB": "/home/daniel/.jevmem/spacemaker.db"
			}
		}
	}
}
